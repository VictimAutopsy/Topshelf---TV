<?xml version="1.0" encoding="utf-8"?>
<!-- Shown the instant TopShelf starts, before the page draws (Android 11 and older; also behind the page). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item android:width="120dp" android:height="120dp" android:gravity="center">
        <bitmap android:src="@drawable/splash_mark" android:gravity="fill" />
    </item>
</layer-list>
